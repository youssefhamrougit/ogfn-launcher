// ogfnlauncher.rc — version info + DPI-aware manifest.
#include <windows.h>

#define VER_FILEVERSION             0,1,0,0
#define VER_FILEVERSION_STR         "0.1.0\0"
#define VER_PRODUCTVERSION          0,1,0,0
#define VER_PRODUCTVERSION_STR      "0.1.0\0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OGFN"
            VALUE "FileDescription",  "OGFN Launcher"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "OGFNLauncher"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "OGFNLauncher.exe"
            VALUE "ProductName",      "OGFN Launcher"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Per-monitor v2 DPI awareness + common-controls v6.
// (WebView2 benefits; keeps HTML crisp at 125/150% scaling.)
1 RT_MANIFEST "ogfnlauncher.manifest"

// Icon (added later; harmless if the file is absent because we only
// reference it when it exists — see note in README).
// 1 ICON "app.ico"
